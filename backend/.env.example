# Copy to backend/.env and fill in ONE key. Never commit .env.

# Free: get a key at https://aistudio.google.com/apikey (Google account, no card)
GEMINI_API_KEY=
# Paid alternative (used only if GEMINI_API_KEY is empty or LIPI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# gemini | anthropic   (blank = pick whichever key is set)
LIPI_PROVIDER=
# Model. Blank = gemini-3.5-flash-lite (biggest free daily quota) or claude-opus-5-5.
# Try gemini-2.5-flash for better reading if your free quota allows.
LIPI_MODEL=
# Claude only: low | medium | high
LIPI_EFFORT=medium
# Force demo responses even when a key is present (1/0)
LIPI_DEMO=0
